# ============================================================
# Base de datos SQL Server
# ============================================================
DB_SERVER=DESKTOP-22GAT46\SQLEXPRESS
DB_NAME=HospitalSanGabriel
DB_USER=sa
# Reemplace este valor por la contraseña real del usuario sa
DB_PASSWORD=tu_contraseña
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=10

# ============================================================
# Seguridad / JWT
# ============================================================
JWT_SECRET_KEY=cambia-esta-clave-por-una-propia
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================
# Aplicación / CORS
# ============================================================
APP_NAME=Hospital San Gabriel - API de Inventario
APP_VERSION=1.0.0
API_PREFIX=/api
DEBUG=True
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
